# Public browser configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public Midtrans Snap configuration.
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
VITE_MIDTRANS_IS_SANDBOX=true

# Server-only secrets belong in Supabase Edge Function secrets:
# MIDTRANS_SERVER_KEY=your-midtrans-server-key
# MIDTRANS_IS_SANDBOX=true
# MIDTRANS_ALLOWED_IPS=comma-separated-official-midtrans-notification-ips
